# Copy to .env.local for development, and set the same values in your host's
# environment for production. Without RESEND_API_KEY and ORDER_FROM_EMAIL the
# order form answers 503 and tells the visitor to email instead — it never
# accepts an order it cannot deliver.

# Where the site is served from, no trailing slash. Everything absolute is built
# from this: canonicals, OG images, JSON-LD and the "Read it online" button. On
# Vercel it can be left unset — the project's production domain is used, and it
# picks up a custom domain by itself once one is attached. Set it explicitly to
# override that, or when hosting anywhere else.
NEXT_PUBLIC_SITE_URL=

# https://resend.com/api-keys
RESEND_API_KEY=

# The sender. Must be an address on a domain verified in Resend, or the send is
# rejected. A display name is fine: "Top Fintech Voices <orders@example.org>"
ORDER_FROM_EMAIL=

# Where orders land. Defaults to site.email when unset.
ORDER_TO_EMAIL=
